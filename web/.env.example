EVCHARGING_API_BASE_URL=http://127.0.0.1:5201
EVCHARGING_WEB_ORIGIN=http://127.0.0.1:3100
# OCPP WebSocket base for the simulator, without a charge point ID.
# For the three-route trial, set this explicitly to the route being tested.
# Direct: wss://vcharging-api-demo.onrender.com/ws/cs/
# Embedded/external: wss://<hostname-from-that-connector-logs>.trycloudflare.com/ws/cs/
# When absent, use /ws/cs/ on the configured API origin (direct mode).
# Set an explicit value when testing a tunnel; no automatic fallback is attempted.
# EVCHARGING_SIMULATOR_WS_BASE_URL=wss://vcharging-api-demo.onrender.com/ws/cs/
