# Placeholders only. Export these deliberately; the suite does not auto-load .env.
# Never use Production or a shared live database. No endpoint has a default.
E2E_ENVIRONMENT=staging
E2E_RESOURCE_ACK=dedicated-test-resources
E2E_BASE_URL=https://e2e-web.example.test
E2E_API_URL=https://e2e-api.example.test
E2E_APPROVED_ORIGINS=https://e2e-web.example.test,https://e2e-api.example.test
E2E_DRIVER_EMAIL=e2e-driver@example.test
E2E_DRIVER_PASSWORD=replace-me-before-running

# Required for the full suite; smoke only exercises login and the Driver map.
E2E_CHARGER_ID=SIM-E2E-001
E2E_CHARGER_PASSWORD=replace-me-before-running
E2E_TAG_ID=TAG-001
