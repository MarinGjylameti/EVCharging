{
  "name": "evcharging-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "check": "expo install --check",
    "test": "node --test tests/*.test.mjs",
    "export": "expo export --platform all",
    "check:ios": "node scripts/check-release.cjs ios",
    "check:android": "node scripts/check-release.cjs android",
    "check:store:ios": "node scripts/check-release.cjs ios --store",
    "check:store:android": "node scripts/check-release.cjs android --store"
  },
  "dependencies": {
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "expo-dev-client": "~6.0.21",
    "expo-splash-screen": "~31.0.13",
    "@react-native-community/datetimepicker": "8.4.4"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
