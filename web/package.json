{
  "name": "evcharging-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next-local.cjs dev --hostname 127.0.0.1 --port 3100",
    "build": "node scripts/next-local.cjs build",
    "start": "node scripts/next-local.cjs start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:smoke": "node e2e/run.mjs --smoke"
  },
  "dependencies": { "next": "15.2.8", "react": "19.0.0", "react-dom": "19.0.0" },
  "devDependencies": { "typescript": "5.9.3", "@types/node": "20.19.37", "@types/react": "19.2.14", "@types/react-dom": "19.2.3" }
}
