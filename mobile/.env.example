# Use an API address reachable from the emulator or phone. Production must use HTTPS.
# Android emulator example: http://10.0.2.2:5201
# An iOS simulator running on the API host can use http://127.0.0.1:5201.
# A physical phone needs the host's LAN address and an API intentionally bound to that interface.
EXPO_PUBLIC_API_BASE_URL=
# Create/configure the EVCharging Expo project before enabling push.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Client-owned public HTTPS pages. Both are mandatory for production builds.
# Deletion must lead directly to an actual account/data deletion request, not a homepage.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
# Android push: EVCharging's Firebase client file, not the Houss configuration.
# On EAS use a file environment variable pointing to the uploaded JSON.
# GOOGLE_SERVICES_JSON=./google-services.json
# Optional existing directory outside the repository for EAS archive staging.
# Otherwise EAS uses the system temporary directory; compiler files remain local.
# EVCHARGING_EAS_TEMP_DIR=
