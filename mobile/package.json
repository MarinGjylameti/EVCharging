{
  "name": "evcharging-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --go --tunnel --clear",
    "upgrade:expo-go": "node scripts/upgrade-expo-go.cjs",
    "build:apk": "node scripts/build-apk.cjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "check": "expo install --check",
    "test": "node --test tests/*.test.mjs",
    "export": "expo export --platform all",
    "check:ios": "node scripts/check-release.cjs ios",
    "check:android": "node scripts/check-release.cjs android",
    "check:store:ios": "node scripts/check-release.cjs ios --store",
    "check:store:android": "node scripts/check-release.cjs android --store"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "26.6.5",
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
