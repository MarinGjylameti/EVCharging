# Set these as environment variables. The API does not automatically read this file.
EVCHARGING_ConnectionStrings__Default=Host=127.0.0.1;Port=5440;Database=evcharging_dev;Username=evcharging;Password=REPLACE_LOCALLY
EVCHARGING_Sessions__LifetimeHours=24
# Master switch. Restart the API after changing. OFF keeps physical charging active.
# Set true only for a test environment to expose simulators and Driver diagnostics.
EVCHARGING_Features__TestMode=false
# Independent route selection; never disables physical OCPP or card authorization.
# direct (default), embedded (cloudflared inside API), external (separate connector).
EVCHARGING_Tunnel__Mode=direct
# Required for embedded outside Render; on Render defaults to RENDER_EXTERNAL_URL.
# EVCHARGING_Tunnel__Origin=https://vcharging-api-demo.onrender.com
EVCHARGING_Push__Enabled=false
EVCHARGING_Push__AccessToken=
# Persistent operational diagnostics; migration PersistentApplicationLogs is required.
EVCHARGING_Diagnostics__RetentionDays=30
EVCHARGING_Diagnostics__QueueCapacity=10000
EVCHARGING_Diagnostics__FlushSeconds=2
# Only for an explicitly requested temporary hosted demo:
# DATABASE_URL=postgresql://USER:PASSWORD@INTERNAL_HOST:5432/evcharging_demo
# EVCHARGING_MIGRATE_ON_START=true
# EVCHARGING_SEED_DEMO_ON_START=true
# EVCHARGING_Demo__DriverEmail=
# EVCHARGING_Demo__DriverPassword=
# Only set for an intentional one-time --bootstrap-superadmin run:
# EVCHARGING_Bootstrap__Email=
# EVCHARGING_Bootstrap__Password=
